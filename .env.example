# Convex Backend
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe Payments & Checkout
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Canonical Site & Application URLs
NEXT_PUBLIC_SITE_URL=https://goodluckcaps.com
# Google Search Console HTML-tag verification token (content value only)
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_APP_URL=https://goodluckcaps.com

# Photo Autofill model through the Vercel AI Gateway (ADR 0027); default google/gemini-2.5-flash.
# Auth: VERCEL_OIDC_TOKEN from `vercel env pull` (expires ~12 h locally) or AI_GATEWAY_API_KEY.
PRODUCT_AUTOFILL_MODEL=

# Guest checkout rate limit per client IP (ADR 0029). Same random value here (Vercel) and in
# each Convex deployment (`npx convex env set CHECKOUT_PASS_SECRET ...`). Unset = shared guest bucket.
CHECKOUT_PASS_SECRET=
